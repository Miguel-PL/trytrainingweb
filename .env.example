# Copia a .env.local / .env.development.local si necesitas overrides locales.
# Producción: usar .env.production o variables del CI antes de `vite build`.

# URL absoluta del backend (producción), con el prefijo que use tu API (p. ej. /api).
# En dev suele omitirse: Vite proxy en vite.config.js reenvía /api al backend local (127.0.0.1:8000).
# VITE_API_URL=https://api.trytraining.es/api
